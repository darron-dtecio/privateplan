{% extends "_base.html.j2" %}
{% block title %}Personal Finance — workspace{% endblock %}
{% block heading %}Personal Finance{% endblock %}
{% block subheading %}All data stays in <code>finance_data/</code> — gitignored, local,
never uploaded.{% endblock %}

{% block crumbs %}
<div class="crumbs">
  <span class="here">Workspace</span><span class="sep">/</span>
  <a href="/finance/intake">Intake</a><span class="sep">/</span>
  {% if has_dashboard %}<a href="/finance/dashboard">Dashboard</a>{% else %}<span class="mut">Dashboard</span>{% endif %}<span class="sep">/</span>
  {% if has_portfolio %}<a href="/finance/portfolio">Portfolio</a>{% else %}<span class="mut">Portfolio</span>{% endif %}
  <span class="sep">/</span><a href="/stocks">Stock analysis</a>
</div>
{% endblock %}

{% block content %}
<div class="card">
  <div class="headline">
    <div>
      <h2>{% if next_step %}Next: {{ next_step.label|lower }}{% else %}Your plan is up to date{% endif %}</h2>
      <p class="sub" style="margin:0">{% if next_step %}{{ next_step.detail }}{% else %}
        Every step has run against the current profile.{% endif %}</p>
    </div>
    {% if next_step %}
      {% if next_step.href %}<a class="btn" href="{{ next_step.href }}">{{ next_step.label }} →</a>
      {% elif next_step.step %}<button type="button" data-step="{{ next_step.step }}">{{ next_step.label }} →</button>
      {% endif %}
    {% elif has_dashboard %}<a class="btn" href="/finance/dashboard">Open dashboard →</a>{% endif %}
  </div>

  <div class="steps">
    {% for s in steps %}
    <div class="step {{ s.state }}">
      <div class="name"><span class="dot"></span>{{ s.label }}</div>
      <div class="detail">{{ s.detail }}</div>
      {% if s.state == 'current' %}<div class="when">you are here</div>
      {% elif s.when %}<div class="when">{{ s.when }}{% if s.optional %} · optional{% endif %}</div>
      {% elif s.optional %}<div class="when">optional</div>{% endif %}
      {% if s.href and s.state != 'current' %}<a href="{{ s.href }}">open</a>{% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="runrow">
    <span class="cap">Run by hand</span>
    <button type="button" data-step="download" class="ghost">Download from links</button>
    <button type="button" data-step="extract" class="ghost">Extract documents</button>
    <button type="button" data-step="analyze" class="ghost">Analyze</button>
    <button type="button" data-step="render" class="ghost">Render dashboard</button>
    <button type="button" data-step="prices" class="ghost">↻ Update prices</button>
    <button type="button" data-step="portfolio" class="ghost">Analyze portfolio <span style="font-weight:500;color:var(--muted)">· several min</span></button>
    <button type="button" data-step="portfolio-render" class="ghost">Rebuild portfolio view</button>
  </div>
  <p class="mut" style="margin:8px 0 0"><b>Update prices</b> fetches a live quote for every holding and rebuilds both dashboards on it, so net worth, allocation and the projection move with the market instead of sitting at the statement date.</p>
  <p class="mut" style="margin:8px 0 0"><b>Analyze portfolio</b> runs the SEC-backed stock analyzer against every individual company you hold and then builds the combined view{% if portfolio_age %} — last built {{ portfolio_age }}{% endif %}.</p>
  <div class="progress" id="progress"><span></span></div>
  <p class="mut" id="status" style="margin:10px 0 6px">{% if running %}<span class="badge run">a job is running</span>{% endif %}</p>
  <pre id="log"></pre>
</div>

<div class="card">
  <h2>Source documents</h2>
  {% if uploaded or duplicates %}<p class="sub">
    {% if uploaded %}{{ uploaded }} new document{{ '' if uploaded == 1 else 's' }} structurally checked and extracted.{% endif %}
    {% if duplicates %}{{ duplicates }} exact duplicate{{ '' if duplicates == 1 else 's' }} skipped.{% endif %}
  </p>{% endif %}
  {% if inbox %}
  {% for f in inbox %}
  <div class="doc">
    <div>
      <div class="name">{{ f.name }}</div>
      <div class="detail">{{ f.detail }}</div>
    </div>
    <span class="stat {{ f.state_cls }}">{{ f.state }}</span>
  </div>
  {% endfor %}
  <p class="mut" style="margin:10px 0 0">A document reads as <b>not used</b> when no
    layout matched it — nothing was taken from it, and nothing in the plan depends on it.</p>
  {% else %}
  <p class="sub">No documents yet. Either paste OneDrive share links below and hit
  <b>Download</b>, or download the files yourself and upload them here.</p>
  {% endif %}
  <form method="post" action="/finance/upload" enctype="multipart/form-data">
    <label for="links">OneDrive share links (one per line{% if links_exists %} — saved links exist{% endif %})</label>
    <textarea id="links" name="links" placeholder="https://1drv.ms/x/c/..."></textarea>
    <label for="docs">Or upload documents (.pdf, .xlsx)</label>
    <input type="file" id="docs" name="docs" multiple accept=".pdf,.xlsx,.csv">
    <div class="btnrow">
      <button type="submit" class="ghost">Save links / upload</button>
    </div>
  </form>
</div>

<div class="note">
  Extraction logs show only field names and confidence — never values — so they're
  safe to share when troubleshooting.
</div>

{% if request.args.get('reset') %}
<div class="note" style="border-color:var(--s2)">
  Removed {{ request.args.get('reset') }} item(s). They are recoverable from
  <code>finance_data/.trash/{{ request.args.get('trash') }}/</code> until you delete that folder.
</div>
{% endif %}

<div class="card" style="border-left:3px solid var(--s2)">
  <h2>Sample data &amp; reset</h2>
  <p class="sub">A fictional household — the Chens, mid-forties, retiring at 62 — with a
  full set of documents to run through the pipeline. Nothing here touches the internet.</p>
  <details>
    <summary style="cursor:pointer">Load the sample household</summary>
    <div class="btnrow" style="margin-top:.6rem">
      <button type="button" data-step="load-sample-profile" class="ghost">Load finished profile</button>
      <button type="button" data-step="load-sample-documents" class="ghost">Load documents only</button>
      <button type="button" data-step="load-samples" class="ghost">Load both</button>
    </div>
    <p class="sub" style="margin-top:.5rem">
      <b>Finished profile</b> gives you a complete plan to Analyze and Render immediately.
      <b>Documents only</b> leaves the profile empty so you can watch extraction build it.
      Loading a profile over one you already have is refused — clear your data first.
    </p>
  </details>

  <details style="margin-top:.8rem">
    <summary style="cursor:pointer;color:var(--s2)">Delete everything in finance_data/</summary>
    <form method="post" action="/finance/reset" style="margin-top:.6rem">
      <p class="sub">
        Moves your profile, analysis, uploaded documents, extracted data and logs into
        <code>finance_data/.trash/</code>. Recoverable until you delete that folder by hand.
      </p>
      <label style="display:block;margin:.4rem 0">
        <input type="checkbox" name="keep_documents" value="1"> keep uploaded documents in the inbox
      </label>
      <label style="display:block;margin:.4rem 0">
        <input type="checkbox" name="then_load" value="1"> reload the sample household afterwards
      </label>
      <label style="display:block;margin:.6rem 0">
        Type <b>DELETE</b> to confirm:
        <input type="text" name="confirm" autocomplete="off" placeholder="DELETE"
               style="margin-left:.4rem;width:8rem">
      </label>
      <button type="submit" class="btn" style="background:var(--s2)">Delete my data</button>
    </form>
  </details>
</div>
{% endblock %}

{% block scripts %}
<script>
(function () {
  var statusEl = document.getElementById('status');
  var logEl = document.getElementById('log');
  var progressEl = document.getElementById('progress');
  var buttons = document.querySelectorAll('[data-step]');
  var timer = null;

  function setBusy(b) {
    buttons.forEach(function (btn) { btn.disabled = b; });
    if (progressEl) progressEl.style.display = b ? 'block' : 'none';
  }

  function poll(jobId) {
    fetch('/finance/job/' + jobId).then(function (r) { return r.json(); }).then(function (j) {
      logEl.style.display = 'block';
      logEl.textContent = j.log_tail || '(no output yet)';
      logEl.scrollTop = logEl.scrollHeight;
      if (j.status === 'running') {
        statusEl.textContent = 'Running ' + j.step + '…';
        timer = setTimeout(function () { poll(jobId); }, 1500);
      } else if (j.status === 'done') {
        // The step changed what every state on this page is derived from, so
        // the page fetches its own new state rather than asking to be reloaded.
        statusEl.textContent = j.step + ' finished — refreshing…';
        setTimeout(function () { location.reload(); }, 1200);
      } else {
        statusEl.textContent = j.step + ' FAILED (exit ' + j.returncode + ') — see log above.';
        setBusy(false);
      }
    }).catch(function () {
      statusEl.textContent = 'Lost contact with the server.';
      setBusy(false);
    });
  }

  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (timer) clearTimeout(timer);
      setBusy(true);
      statusEl.textContent = 'Starting ' + btn.dataset.step + '…';
      fetch('/finance/run/' + btn.dataset.step, { method: 'POST' })
        .then(function (r) {
          if (!r.ok) return r.text().then(function (t) { throw new Error(t); });
          return r.json();
        })
        .then(function (j) { poll(j.job_id); })
        .catch(function (e) {
          statusEl.textContent = 'Could not start: ' + e.message;
          setBusy(false);
        });
    });
  });
})();
</script>
{% endblock %}
